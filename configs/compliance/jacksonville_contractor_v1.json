{
  "version": "1.0.0",
  "name": "Jacksonville Contractor Compliance",
  "description": "Materiality Matrix for Jacksonville-based contractors",
  "sectors": ["construction", "maritime", "logistics", "legal"],
  "violation_patterns": {
    "CRITICAL": [
      "bypass osha safety",
      "skip fall protection",
      "omit davis-bacon wage",
      "under-bid structural steel",
      "exclude rebar costs",
      "hide contingency",
      "front-load change orders",
      "fabricate safety log"
    ],
    "HIGH": [
      "circumvent inspection",
      "unauthorized override",
      "skip ppe requirement",
      "material substitution",
      "undocumented overtime"
    ],
    "MEDIUM": [
      "incomplete documentation",
      "delayed reporting",
      "minor deviation"
    ]
  },
  "materiality_tiers": {
    "TIER_1": {
      "threshold": 50000,
      "requires_dhitl": true,
      "domains": ["safety", "financial", "legal"]
    },
    "TIER_2": {
      "threshold": 10000,
      "requires_dhitl": false,
      "domains": ["operations", "logistics"]
    },
    "TIER_3": {
      "threshold": 0,
      "requires_dhitl": false,
      "domains": ["admin", "informational"]
    }
  },
  "domain_keywords": {
    "safety": ["osha", "ppe", "fall protection", "scaffold", "hazard", "safety"],
    "financial": ["bid", "estimate", "margin", "cost", "pricing", "invoice", "payment"],
    "legal": ["contract", "far", "dfars", "clause", "indemnification", "liability"],
    "operations": ["schedule", "delivery", "inspection", "permit"],
    "logistics": ["transport", "fleet", "hazmat", "dot", "shipping"],
    "admin": ["internal", "hr", "training"]
  },
  "trigger_patterns": [
    {
      "pattern": "\\d+%.*margin",
      "tier": "TIER_1",
      "action": "flag"
    },
    {
      "pattern": "skip.*safety",
      "tier": "TIER_1",
      "action": "interrupt"
    },
    {
      "pattern": "below\\s+\\d+%",
      "tier": "TIER_2",
      "action": "flag"
    }
  ],
  "policies": {
    "osha": {
      "name": "OSHA Safety Standards",
      "violations": ["work without ppe", "bypass safety", "skip inspection"]
    },
    "davis_bacon": {
      "name": "Davis-Bacon Act",
      "violations": ["prevailing wage", "underpay labor", "misclassify"]
    },
    "far": {
      "name": "FAR Compliance",
      "violations": ["omit clause", "unauthorized deviation"]
    },
    "dot": {
      "name": "DOT HAZMAT",
      "violations": ["unlicensed hazmat", "missing placards", "exceed hours"]
    }
  }
}