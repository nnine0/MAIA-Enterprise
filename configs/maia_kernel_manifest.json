      "tool_id": "GOVERNED_SMTP_V1",
      "description": "PII-locked email workflow for contractor-client communications.",
      "neural_layer": {
        "adapter_id": "email_governed_workflow",
        "base_model": "google/gemma-4-2b-it",
        "logit_bias_mask": "configs/masks/pii_standard.json",
        "max_tokens": 512
      },
      "governance_layer": {
        "materiality": "MEDIUM",
        "airlock_policy": "configs/compliance/pii_redaction.json",
        "required_forensic_hash": "latent_EKG_v1"
      },
      "action_layer": {
        "protocol": "json-rpc",
        "endpoint": "https://internal-mail-gateway.local/rpc",
        "method": "send_secure_email",
        "parameters": {
          "recipient": "string",
          "subject": "string",
          "body": "string",
          "attachment_hash": "string (optional)"
        }
      }
    },
