# MAIA Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# CORE SERVICES
# =============================================================================

# LoRAX Inference Server
LORAX_URL=http://lorax:80

# Vector Database (Qdrant)
QDRANT_URL=http://vector-db:6333

# OCR Service (CPU-only to avoid GPU contention)
OCR_URL=http://ocr:5000

# Embeddings Service
EMBEDDINGS_URL=http://embeddings:6000

# Redis Task Queue
REDIS_URL=redis://redis:6379/0

# =============================================================================
# API CONFIGURATION
# =============================================================================

# MAIA API Key (used for authentication)
MAIA_API_KEY=your-secure-api-key-here

# OpenAI API Key (for data augmentation during training - optional)
# OPENAI_API_KEY=sk-...

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Base Model ID (used by LoRAX)
# Examples: Nanbeige/Nanbeige4-3B-Thinking-2511, google/gemma-4-26b-a4b-moe
BASE_MODEL_ID=Nanbeige/Nanbeige4-3B-Thinking-2511

# =============================================================================
# TRAINING CONFIGURATION (Optional - for adapter training)
# =============================================================================

# Default adapter name
# DEFAULT_ADAPTER_NAME=adapter_math

# Dataset path for training
# DEFAULT_DATASET_PATH=gsm8k

# Expert data path
# DEFAULT_EXPERT_DATA_PATH=maiadeen_law.json

# =============================================================================
# GPU CONFIGURATION
# =============================================================================

# Set to "" for CPU-only services, or "0" for first GPU
# CUDA_VISIBLE_DEVICES=0

# =============================================================================
# PATHS
# =============================================================================

# Adapter storage directory
# ADAPTERS_DIR=/adapters

# Data logs directory
# DATA_LOGS_DIR=/data_logs

# Adapter metadata file
# METADATA_FILE=/adapters/adapter_metadata.json

# =============================================================================
# LIMITATIONS / KNOWN ISSUES
# =============================================================================
# - MAX_CONTEXT_LENGTH is 2000 tokens (short for enterprise document RAG)
# - On single-GPU machines, lorax, maia-app, trainer, and worker will conflict
#   (currently all request count:1 GPU)
# - OCR is CPU-pinned to avoid contention (resolved in docker-compose)